# Ghostty config — only non-default options are set.
# `ghostty +show-config --default --docs` lists everything.

background-opacity = 0.8

theme = Gruvbox Dark

# alt + 1-5 just sends escape code for alt + 1-5
# because for some reason it doesnt recognize
# alt + num just as is
keybind = alt+1=text:\x1b1
keybind = alt+2=text:\x1b2
keybind = alt+3=text:\x1b3
keybind = alt+4=text:\x1b4
keybind = alt+5=text:\x1b5

keybind = alt+k=scroll_page_lines:-3
keybind = alt+j=scroll_page_lines:3
keybind = alt+ctrl+u=scroll_page_fractional:-0.5
keybind = alt+ctrl+d=scroll_page_fractional:0.5

font-size=10
