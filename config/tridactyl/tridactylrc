" TODO: add functionality to set some kind of mark when you unfocus a tab
" and then have <C-o> take you there

set configversion 2.0
set smoothscroll true


" TODO: what are these
" set hintchars hjklasdfgyuiopqwertnmzxcvb

" Search engines
" set searchengine duckduckgo
" set searchurls.g https://www.google.com/search?q=%s
" set searchurls.gh https://github.com/search?q=%s
" set searchurls.yt https://www.youtube.com/results?search_query=%s

" Keybindings
bind <C-j> tabnext
bind <C-k> tabprev
bind d scrollpage 0.5
bind u scrollpage -0.5
bind x tabclose
bind X undo

" Dump every open tab into diane, then quit — only if the drop succeeded.
" Logic lives in tabdump.js next to this file.
command tabdump jsb -r tabdump.js
bind ZD tabdump

" New tab = diane's capture textbox (served locally, see nixos/modules/packages/diane.nix).
" ?newtab keeps focus off the textbox so Tridactyl binds work; `gi` to type a note.
" Must be a real http page: Tridactyl can't run on about: pages (ZD etc. would do nothing).
set newtab http://127.0.0.1:7777/?newtab

" Theme
colors midnight

" Disable on certain sites
autocmd DocStart ^http(s?)://mail.google.com tabopen about:blank

" Native messenger features (requires native messenger)
" Set download location
set downloadpath ~/Downloads

" Editor for text areas (requires native messenger)
set editorcmd ghostty --title=tridactyl-editor -e nvim
